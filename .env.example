TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
PRESENTER_PHONE=+61400000000

# One number per concurrent session. A session claims one at creation and
# releases it when it ends. Defaults to TWILIO_PHONE_NUMBER alone, which caps
# you at one live session — the voice agent identifies a session by the number
# that was called, so two events sharing a sender cannot be told apart.
TWILIO_PHONE_POOL=+1234567890,+1234567891

# Seeded into the presenter allowlist at every boot, so an emptied allowlist
# cannot lock everyone out. Comma-separated E.164.
PRESENTER_BOOTSTRAP_PHONES=+61400000000
TWILIO_VOICE=Google.en-AU-Neural2-B

# The one origin Twilio reaches this backend on, used for every URL Twilio
# fetches or signs: webhook signatures cover the full URL, and behind a proxy the
# request itself reports http, so this cannot be derived from the request. Set it
# to the tunnel origin when developing against real webhooks.
PUBLIC_BASE_URL=http://localhost:3001

# Signs presenter session tokens (12h, HS256). REQUIRED — the backend refuses to
# boot without it, because a guessable secret is the same as no auth on routes
# that text and call real phones. Generate with: openssl rand -hex 32
PRESENTER_JWT_SECRET=
VITE_AUDIENCE_URL=https://your-ngrok-url.ngrok.app

# ConversationRelay (leave CONVERSATION_RELAY_URL empty to use static TwiML fallback).
# The relay is its own Fly app, so this is its wss:// origin — e.g.
# wss://twilio-preso-relay.fly.dev — not a path on this backend.
CONVERSATION_RELAY_URL=
CONVERSATION_RELAY_PORT=3003

# --- LLM provider (used by the AI-prompt slide and the voice agent) ---
# LLM_PROVIDER: anthropic | openai
# LLM_MODEL:    provider model id (default: gpt-4o-mini / claude-haiku-4-5-20251001)
# LLM_API_KEY:  falls back to OPENAI_API_KEY or ANTHROPIC_API_KEY
# LLM_BASE_URL: optional host override. With LLM_PROVIDER=openai this targets any
#               OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama, …)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=
# Default credential — OpenRouter (OpenAI-compatible, every model on one key).
# Set this and nothing else and both the AI slide and the voice agent work.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The voice agent can override any of the above with a VOICE_ prefix, e.g.:
# VOICE_LLM_MODEL=claude-haiku-4-5-20251001

OUTBOUND_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Local development ---
# When true, skip Twilio Verify: no SMS is sent and DEV_BYPASS_CODE is accepted.
# This now also bypasses PRESENTER sign-in, not just audience registration — any
# allowlisted phone can sign in with the bypass code. Never enable in production.
DEV_BYPASS_VERIFY=false
DEV_BYPASS_CODE=123456
# --- Conversation Memory (optional) ---
# Store holding the audience's Customer Profiles. Leave unset to turn the feature
# off entirely: no profiles are created, and personalized SMS and the voice agent
# fall back to the session's own Sync responses. Read by both the backend and the
# ConversationRelay server.
TWILIO_MEMORY_STORE_ID=

# --- WhatsApp (optional) ---
# A WhatsApp-enabled sender, `whatsapp:+…` or a bare E.164 number. Separate from
# the phone pool because a WhatsApp sender is registered per number with Meta, so
# a session's claimed pool number almost certainly is not one. Leave unset and the
# `whatsapp-` triggers send as SMS instead. Note that a business-initiated
# free-form message outside the 24-hour customer service window is rejected with
# error 63016; the trigger catches that and re-sends as SMS to that recipient.
TWILIO_WHATSAPP_FROM=
