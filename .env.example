TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
PRESENTER_PHONE=+61400000000

# One number per concurrent session. A session claims one at creation and
# releases it when it ends. Defaults to TWILIO_PHONE_NUMBER alone, which caps
# you at one live session — the voice agent identifies a session by the number
# that was called, so two events sharing a sender cannot be told apart.
TWILIO_PHONE_POOL=+1234567890,+1234567891

# Seeded into the presenter allowlist at every boot, so an emptied allowlist
# cannot lock everyone out. Comma-separated E.164.
PRESENTER_BOOTSTRAP_PHONES=+61400000000
TWILIO_VOICE=Google.en-AU-Neural2-B
BACKEND_URL=http://localhost:3001
VITE_AUDIENCE_URL=https://your-ngrok-url.ngrok.app

# ConversationRelay (leave CONVERSATION_RELAY_URL empty to use static TwiML fallback)
CONVERSATION_RELAY_URL=
CONVERSATION_RELAY_PORT=3003

# --- LLM provider (used by the AI-prompt slide and the voice agent) ---
# LLM_PROVIDER: anthropic | openai
# LLM_MODEL:    provider model id (default: claude-haiku-4-5-20251001 / gpt-4o-mini)
# LLM_API_KEY:  falls back to ANTHROPIC_API_KEY or OPENAI_API_KEY
# LLM_BASE_URL: optional host override. With LLM_PROVIDER=openai this targets any
#               OpenAI-compatible endpoint (OpenRouter, Groq, Together, Ollama, …)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The voice agent can override any of the above with a VOICE_ prefix, e.g.:
# VOICE_LLM_MODEL=claude-haiku-4-5-20251001

OUTBOUND_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OUTBOUND_TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Local development ---
# When true, skip Twilio Verify: no SMS is sent and DEV_BYPASS_CODE is accepted.
DEV_BYPASS_VERIFY=false
DEV_BYPASS_CODE=123456